          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['endedAt', 'minutes', 'orderTitle', 'updatedAt']);
        allow delete: if isValidId(entryId) && isWorkspaceOwner(workspaceId);
      }
    }
  }
}
